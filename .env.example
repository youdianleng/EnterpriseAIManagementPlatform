# Copy to .env and adjust. Every value here has a working default in
# docker-compose.yml, so the stack starts without a .env file.

# --- Postgres ---
POSTGRES_USER=eam
POSTGRES_PASSWORD=eam_dev_password
POSTGRES_DB=eam
POSTGRES_PORT=5432

# The role requests run as. It is created by migration 0007 and cannot rewrite
# the audit trail or read withheld employee details outside its own. Set a real
# password in production; the default exists so `docker compose up` needs no
# manual step.
APP_DB_USER=eam_app
APP_DB_PASSWORD=eam_app_dev_password

# --- Redis ---
REDIS_PORT=6379

# --- API ---
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# Two lifetimes, deliberately different. Audit records are evidence and are kept
# for four years; runtime logs are diagnostics, written to stdout, kept 14 days by
# whatever collects them. Changing either is a compliance decision, not a
# housekeeping one.
AUDIT_RETENTION_DAYS=1460
LOG_RETENTION_DAYS=14

# --- Web ---
# Must be reachable from the browser, so keep it as a host-facing URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000

# --- Mail (daily digest) ---
# Development and demo send every message to Mailpit, which accepts everything and
# delivers nothing: http://localhost:8025 is where the rendered mail is read.
# `SMTP_USER`/`SMTP_PASSWORD` are optional and unset here on purpose — Mailpit
# wants neither, and a real relay is a deployment's own secret to supply.
MAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@empresa.es
SMTP_STARTTLS=false
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Where a digest's link points: the browser's URL for the web app, not the
# container's. The digest itself runs as
# `python -m app.jobs.send_daily_digests [YYYY-MM-DD]` (see README).
WEB_BASE_URL=http://localhost:3000
# Written in the recipient's language when their account has stored one
# (`users.locale`), and in this one when it has not.
DIGEST_DEFAULT_LANGUAGE=es
DIGEST_MAX_ATTEMPTS=3
