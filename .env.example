# Copy to .env and adjust. Every value here has a working default in
# docker-compose.yml, so the stack starts without a .env file.

# --- Postgres ---
POSTGRES_USER=eam
POSTGRES_PASSWORD=eam_dev_password
POSTGRES_DB=eam
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# --- Web ---
# Must be reachable from the browser, so keep it as a host-facing URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
